rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile data
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // User chat sessions
    match /users/{userId}/chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
